@using Aiursoft.AiurDrive.Entities
@model Aiursoft.AiurDrive.Models.SharesViewModels.ManageSharesViewModel
@inject Aiursoft.AiurDrive.Services.FileStorage.StorageService StorageService

@{
    string DescribeRecipients(IEnumerable<string> recipients, bool roles)
    {
        var names = recipients.OrderBy(name => name).ToList();
        if (names.Count == 0) return string.Empty;
        if (names[0].Length > 40)
        {
            if (names.Count == 1)
            {
                if (roles) return string.Format(@Localizer["{0} role"].Value, names.Count);
                return string.Format(@Localizer["{0} user"].Value, names.Count);
            }
            if (roles) return string.Format(@Localizer["{0} roles"].Value, names.Count);
            return string.Format(@Localizer["{0} users"].Value, names.Count);
        }
        if (roles)
        {
            if (names.Count == 1) return string.Format(@Localizer["Role {0}"].Value, names[0]);
            if (names.Count == 2) return string.Format(@Localizer["Role {0} and {1} other role"].Value, names[0], names.Count - 1);
            return string.Format(@Localizer["Role {0} and {1} other roles"].Value, names[0], names.Count - 1);
        }
        if (names.Count == 1) return names[0];
        if (names.Count == 2) return string.Format(@Localizer["{0} and {1} other user"].Value, names[0], names.Count - 1);
        return string.Format(@Localizer["{0} and {1} other users"].Value, names[0], names.Count - 1);
    }

    var accessDescriptions = new List<string>();
    foreach (var permission in new[] { SharePermission.ReadOnly, SharePermission.Editable })
    {
        var shares = Model.ExistingShares.Where(share => share.Permission == permission).ToList();
        var roles = DescribeRecipients(shares.Where(share => share.SharedWithRoleId != null).DistinctBy(share => share.SharedWithRoleId)
            .Select(share => Model.AvailableRoles.FirstOrDefault(role => role.Id == share.SharedWithRoleId)?.Name ?? share.SharedWithRoleId!), true);
        var users = DescribeRecipients(shares.Where(share => share.SharedWithUserId != null).DistinctBy(share => share.SharedWithUserId)
            .Select(share => share.SharedWithUser?.DisplayName ?? share.SharedWithUserId!), false);
        var recipients = string.IsNullOrEmpty(roles) ? users : string.IsNullOrEmpty(users) ? roles : string.Format(@Localizer["{0}, {1}"].Value, roles, users);
        if (string.IsNullOrEmpty(recipients)) continue;
        if (permission == SharePermission.ReadOnly)
        {
            if (Model.IsPublic) continue;
            accessDescriptions.Add(string.Format(@Localizer["{0} can view."].Value, recipients));
        }
        else
        {
            accessDescriptions.Add(string.Format(@Localizer["{0} can edit."].Value, recipients));
        }
    }
}

<div id="sharing-page" class="mx-auto" style="max-width: 960px;">
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
        <div class="min-w-0">
            <div class="text-muted mb-1">@Localizer["Manage Shares"]</div>
            <h1 class="h3 text-break mb-2">@Model.SiteName</h1>
        </div>
        <a asp-controller="Dashboard" asp-action="Files" asp-route-siteName="@Model.SiteName" class="btn btn-outline-primary">
            <i class="align-middle" data-lucide="arrow-left" aria-hidden="true"></i> @Localizer["Back to Files"]
        </a>
    </div>

    <div id="access-summary" class="d-flex align-items-start gap-2 border rounded px-3 py-2 mb-4 text-break" aria-label="@Localizer["Current access"]">
        <i class="align-middle flex-shrink-0" data-lucide="@(Model.IsPublic ? "globe" : "lock")" aria-hidden="true"></i>
        <div>
            @if (Model.IsPublic)
            {
                <span>@Localizer["Anyone with the link can view without signing in."]</span>
            }
            else if (!Model.ExistingShares.Any())
            {
                <span>@Localizer["Only the owner and authorized administrators have access."]</span>
            }
            else
            {
                <span>@Localizer["Only authorized people can access."]</span>
            }
            @foreach (var description in accessDescriptions)
            {
                <span>@description</span>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h2 class="card-title mb-0">@Localizer["Shared access"] <span class="text-muted">(@Model.ExistingShares.Count)</span></h2>
        </div>
        <div class="card-body pt-0">
            @if (!Model.ExistingShares.Any())
            {
                <p class="text-muted py-3 mb-0">@Localizer["No users or roles added."]</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var share in Model.ExistingShares)
                    {
                        <li class="list-group-item px-0 py-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <div class="d-flex align-items-center gap-3 text-break">
                                @if (share.SharedWithUser != null)
                                {
                                    <img src="@(StorageService.RelativePathToInternetUrl(share.SharedWithUser.AvatarRelativePath))?w=128&amp;square=true" alt="" class="rounded-circle flex-shrink-0" width="36" height="36">
                                }
                                else
                                {
                                    <span class="d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;"><i class="align-middle" data-lucide="@(share.SharedWithUserId != null ? "user" : "users")" aria-hidden="true"></i></span>
                                }
                                <div>
                                    <div class="fw-semibold">@(share.SharedWithUserId != null ? share.SharedWithUser?.DisplayName ?? share.SharedWithUserId : Model.AvailableRoles.FirstOrDefault(r => r.Id == share.SharedWithRoleId)?.Name ?? share.SharedWithRoleId)</div>
                                    <div class="small text-muted">
                                        @if (share.SharedWithUserId != null)
                                        {
                                            @Localizer["User"]
                                        }
                                        else
                                        {
                                            @Localizer["Role"]
                                        }
                                        <span aria-hidden="true"> · </span><span data-utc-time="@share.CreationTime.ToString("o")"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3 ms-auto">
                                @if (share.Permission == SharePermission.ReadOnly)
                                {
                                    <span class="badge bg-secondary">@Localizer["Can view"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@Localizer["Can edit"]</span>
                                }
                                <form asp-action="RemoveShare" method="post" class="remove-share-form">
                                    <input type="hidden" name="id" value="@share.Id">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Remove"]</button>
                                    <div class="small text-danger mt-2 form-error" role="alert" hidden></div>
                                </form>
                            </div>
                        </li>
                    }
                </ul>
            }
            <details class="mt-3 small text-muted">
                <summary>@Localizer["About access"]</summary>
                <p class="mt-2 mb-1">@Localizer["The owner and authorized site administrators also have access. Role access applies to its members; permissions from other roles or direct shares still apply after removing one share."]</p>
                <p class="mb-0">@Localizer["Can view allows reading and downloading files. Can edit also allows uploading, changing and deleting files, but does not grant site administration."]</p>
            </details>
            <details id="add-share-details" class="mt-3 border-top pt-3">
                <summary class="fw-semibold">@Localizer["Add access"]</summary>
                <form asp-action="AddShare" asp-route-siteName="@Model.SiteName" method="post" id="add-share-form" class="mt-3">
                    <fieldset class="mb-3">
                        <legend class="form-label fs-6">@Localizer["Share with"]</legend>
                        <div class="btn-group" role="group" aria-label="@Localizer["Share with"]">
                            <input type="radio" class="btn-check" name="shareType" id="shareTypeRole" value="role" checked>
                            <label class="btn btn-outline-primary" for="shareTypeRole">@Localizer["Role"]</label>
                            <input type="radio" class="btn-check" name="shareType" id="shareTypeUser" value="user">
                            <label class="btn btn-outline-primary" for="shareTypeUser">@Localizer["User"]</label>
                        </div>
                    </fieldset>
                    <div class="row g-3 align-items-end">
                        <div class="col-md-7">
                            <div id="role-selection">
                                <label class="form-label" for="roleSelect">@Localizer["Role"]</label>
                                <select class="form-select" name="TargetRoleId" id="roleSelect" required>
                                    <option value="">@Localizer["Select a role..."]</option>
                                    @foreach (var role in Model.AvailableRoles)
                                    {
                                        <option value="@role.Id">@role.Name</option>
                                    }
                                </select>
                            </div>
                            <div id="user-selection" hidden>
                                <label class="form-label" for="userSearch">@Localizer["User"]</label>
                                <input type="search" class="form-control" id="userSearch" placeholder="@Localizer["Name or email (3+ characters)"]" autocomplete="off" aria-controls="userSearchResults" aria-describedby="user-search-status" disabled>
                                <input type="hidden" name="TargetUserId" id="selectedUserId" disabled>
                                <div id="user-search-status" class="small text-muted mt-1" role="status"></div>
                                <div id="userSearchResults" class="list-group mt-2 d-none" style="max-height: 240px; overflow-y: auto;"></div>
                                <div id="selectedUserDisplay" class="d-flex align-items-center justify-content-between border rounded p-2 mt-2 gap-2 d-none">
                                    <div class="text-break"><strong id="selectedUserName"></strong><div id="selectedUserUsername" class="small text-muted"></div></div>
                                    <button type="button" class="btn btn-sm btn-outline-primary" id="clearSelectedUser">@Localizer["Change"]</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label" for="share-permission">@Localizer["Permission"]</label>
                            <select class="form-select" name="Permission" id="share-permission" required>
                                <option value="0">@Localizer["Can view"]</option>
                                <option value="1">@Localizer["Can edit"]</option>
                            </select>
                        </div>
                    </div>
                    <div class="small text-danger mt-3 form-error" role="alert" hidden></div>
                    <button type="submit" class="btn btn-primary mt-3">@Localizer["Add access"]</button>
                </form>
            </details>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h2 class="card-title mb-0">@Localizer["Link access"]</h2></div>
        <div class="card-body pt-0">
            <p class="text-muted" id="saved-link-scope">
                @if (Model.IsPublic)
                {
                    @Localizer["Anyone with the link can view and download files without signing in."]
                }
                else
                {
                    @Localizer["Sign-in and existing access are required. Copying a link does not grant access."]
                }
            </p>
            <div class="input-group mb-3">
                <input type="text" class="form-control" value="@(Model.IsPublic ? Model.PublicLink : Url.Action("Files", "Dashboard", new { siteName = Model.SiteName }, Context.Request.Scheme))" readonly id="share-link" aria-label="@Localizer["Share Link"]" aria-describedby="saved-link-scope">
                <button type="button" class="btn btn-outline-primary" id="copy-share-link">@Localizer["Copy link"]</button>
            </div>
            <div id="copy-status" class="small mb-3" role="status" hidden></div>
            <details id="link-access-details">
                <summary class="fw-semibold">@Localizer["Change link access"]</summary>
                <form asp-action="UpdateVisibility" asp-route-siteName="@Model.SiteName" method="post" id="visibility-form" class="mt-3" data-saved-public="@Model.IsPublic.ToString().ToLowerInvariant()">
                    <label for="link-access" class="form-label">@Localizer["Who can use the link?"]</label>
                    <select name="publicAccess" id="link-access" class="form-select">
                        <option value="false" selected="@(!Model.IsPublic)">@Localizer["People with access"]</option>
                        <option value="true" selected="@(Model.IsPublic)">@Localizer["Anyone — view only"]</option>
                    </select>
                    <p class="small text-muted mt-2 mb-0">@Localizer["Anonymous viewing does not change the user or role permissions above."]</p>
                    <p id="visibility-pending" class="small mt-2 mb-0" role="status" hidden>@Localizer["Not saved. The link above still uses the current access setting."]</p>
                    <div class="small text-danger mt-2 form-error" role="alert" hidden></div>
                    <button type="submit" class="btn btn-primary mt-3">@Localizer["Save access"]</button>
                </form>
            </details>
        </div>
    </div>
    <div id="sharing-loc" hidden>
        <span data-key="invalid">@Localizer["Select a user from the search results or choose a role."]</span>
        <span data-key="duplicate">@Localizer["This user or role already has access to this site."]</span>
        <span data-key="failed">@Localizer["Could not confirm the change. Your input is kept. Try again, or reload to check the saved state."]</span>
        <span data-key="remove">@Localizer["Remove this share? Other access may still apply."]</span>
        <span data-key="searching">@Localizer["Searching..."]</span>
        <span data-key="noUsers">@Localizer["No users found. Try another name or email."]</span>
        <span data-key="searchFailed">@Localizer["Search failed. Change the search text to try again."]</span>
        <span data-key="copied">@Localizer["Link copied."]</span>
        <span data-key="copyFailed">@Localizer["Could not copy. Select and copy the link above."]</span>
    </div>
</div>

@section scripts {
    <script src="~/scripts/manage-shares.js" asp-append-version="true" defer></script>
}
